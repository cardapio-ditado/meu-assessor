# Meu Assessor - variaveis de ambiente (valores ficticios; nunca comitar valores reais)

# --- Banco ---
# Local: conexao direta.
DATABASE_URL=postgres://meu_assessor_app:TROCAR@localhost:5432/meu_assessor
DATABASE_POOL_MAX=10
# Em execucao serverless use a string do POOLER em modo transacao do provedor,
# nao a conexao direta: instancias frias esgotariam as conexoes do banco.
# O papel precisa ser criado NOBYPASSRLS (docs/runbooks/banco.md).
# DATABASE_SSL_NO_VERIFY=1  # quando o pooler nao apresenta cadeia verificavel

# --- API ---
API_PORT=8787
API_BASE_URL=http://localhost:8787
# Assina o identificador de sessao. Ao menos 32 caracteres:
#   head -c 48 /dev/urandom | base64
SESSION_SECRET=
# Senha do ambiente de demonstracao. Sem valor definido, nenhum login e aceito.
# Nao ha senha padrao no codigo (17.3).
DEMO_PASSWORD=

# --- Municipio padrao do piloto (config, nunca codigo) ---
DEFAULT_TENANT_SLUG=varzea-grande

# --- Provedor de IA (camada substituivel; opcional) ---
# Sem chave o produto opera em modo deterministico: fatos, calculos e
# evidencias continuam funcionando; a sintese longa fica desativada.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_MAX_TOKENS_PER_QUESTION=4000
AI_MONTHLY_BUDGET_BRL=0

# --- Transcricao de voz (opcional) ---
STT_PROVIDER=none
STT_API_KEY=
STT_MAX_SECONDS=90

# --- Coleta ---
INGESTION_USER_AGENT=MeuAssessor/0.1 (+contato-operacional)
INGESTION_TIMEOUT_MS=25000
INGESTION_MAX_PAGES_PER_RUN=50
INGESTION_OVERLAP_DAYS=30
# allowlist de hosts de coleta; vazio = nenhuma coleta externa permitida
INGESTION_ALLOWED_HOSTS=

# --- Canal opcional (nao habilitar sem elegibilidade documentada) ---
WHATSAPP_ENABLED=false
